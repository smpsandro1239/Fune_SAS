generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  DESIGNER
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum FuneralStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum ServiceType {
  CERIMONIA
  VELORIO
  CREMACAO
  TRANSPORTE
  ACOLHIMENTO
  OUTRO
}

enum DocumentType {
  CERTIFICATE
  AUTHORIZATION
  CONTRACT
  IDENTITY
  PRESENCA
  PROGRAMA
  CREMACAO
  TRANSPORTE_DOCS
  RELATORIO
  SEPULTURA
  CONDOLENCIA
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum PublicationPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  TIKTOK
  YOUTUBE
}

enum FlyerPlan {
  FREE
  PREMIUM
  ULTRA
}

enum NotificationType {
  EMAIL
  SMS
  TAREFA
  LEMBRETE
  SISTEMA
}

model Agency {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  logoUrl          String?
  phone            String?
  email            String?
  address          String?
  location         String?
  foundedYear      String?
  website          String?
  subscriptionPlan SubscriptionPlan @default(FREE)

  // Redes sociais
  facebookPageId   String?
  facebookPageUrl  String?
  facebookPageAccessToken String?
  instagramAccount String?
  instagramPageUrl String?
  instagramBusinessId     String?
  linkedinUrl      String?
  twitterUrl       String?
  youtubeUrl       String?
  tiktokUrl        String?

  // Configuração de publicação
  autoPublish      Boolean          @default(false)
  publishDefaultMsg String?
  condolenceModeration Boolean      @default(false)

  users            User[]
  deceaseds        Deceased[]
  funerals         Funeral[]
  documents        Document[]
  subscriptions    Subscription[]
  notifications    Notification[]
  flyerDrafts      FlyerDraft[]
  publications     Publication[]
  publicationTemplates PublicationTemplate[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  agencyId           String
  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(OPERATOR)
  refreshTokens      RefreshToken[]
  passwordResetToken PasswordResetToken?
  notifications      Notification[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Deceased {
  id           String    @id @default(cuid())
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  fullName     String
  age          Int?
  dateOfBirth  DateTime?
  dateOfDeath  DateTime?
  placeOfDeath String?
  photoUrl     String?
  funerals     Funeral[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([agencyId])
  @@index([fullName])
}

model Funeral {
  id                  String        @id @default(cuid())
  agencyId            String
  agency              Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  deceasedId          String
  deceased            Deceased      @relation(fields: [deceasedId], references: [id], onDelete: Cascade)
  serviceType         ServiceType   @default(CERIMONIA)
  funeralDate         DateTime
  funeralTime         String?
  locationParish      String?
  cemeteryLocation    String?
  wakeLocation        String?
  wakeDate            DateTime?
  wakeTime            String?
  notes               String?
  status              FuneralStatus @default(SCHEDULED)
  publicNoticeEnabled Boolean       @default(true)
  documents           Document[]
  condolences        Condolence[]
  publications       Publication[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([agencyId, funeralDate])
  @@index([agencyId, status])
}

model Document {
  id              String     @id @default(cuid())
  agencyId        String
  agency          Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  funeralId       String?
  funeral         Funeral?   @relation(fields: [funeralId], references: [id], onDelete: SetNull)
  title           String
  type            DocumentType
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  uploadedById    String?
  createdAt       DateTime   @default(now())

  @@index([agencyId, createdAt])
  @@index([fileName])
}

model FlyerTemplate {
  id             String   @id
  name           String
  plan           FlyerPlan
  category       String   @default("PARTICIPACAO")
  description    String?
  primaryColor   String
  secondaryColor String
  accentColor    String
  fontFamily     String
  layoutStyle    String
  thumbnailUrl   String?
  editableFields Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id         String             @id @default(cuid())
  agencyId   String
  agency     Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  priceCents Int?
  validUntil DateTime?
  startedAt  DateTime           @default(now())
  createdAt  DateTime           @default(now())

  @@index([agencyId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  agencyId  String
  agency    Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      NotificationType @default(SISTEMA)
  title     String
  message   String
  readAt    DateTime?
  sentAt    DateTime         @default(now())
}

model Condolence {
  id        String   @id @default(cuid())
  funeralId String
  funeral   Funeral  @relation(fields: [funeralId], references: [id], onDelete: Cascade)
  authorName String
  message   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([funeralId, approved, createdAt])
}

model FlyerDraft {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  layoutStyle  String
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
}

model Publication {
  id              String              @id @default(cuid())
  agencyId        String
  agency          Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  funeralId       String?
  funeral         Funeral?            @relation(fields: [funeralId], references: [id], onDelete: SetNull)
  templateId      String?
  title           String
  caption         String
  imageUrl        String?
  imageBase64     String?
  platform        PublicationPlatform
  status          PublicationStatus   @default(DRAFT)
  scheduledFor    DateTime?
  publishedAt     DateTime?
  externalPostId  String?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([agencyId, status])
  @@index([scheduledFor])
}

model PublicationTemplate {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  captionTemplate String
  hashtags        String?
  imageTemplate   String?
  platforms       Json     @default("[\"FACEBOOK\",\"INSTAGRAM\"]")
  autoOnCreate    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agencyId])
}
