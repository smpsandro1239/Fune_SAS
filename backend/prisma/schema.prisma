generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  DESIGNER
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum FuneralStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum ServiceType {
  CERIMONIA
  VELORIO
  CREMACAO
  TRANSPORTE
  ACOLHIMENTO
  OUTRO
}

enum DocumentType {
  CERTIFICATE
  AUTHORIZATION
  CONTRACT
  IDENTITY
}

enum FlyerPlan {
  FREE
  PREMIUM
  ULTRA
}

enum NotificationType {
  EMAIL
  SMS
  TAREFA
  LEMBRETE
  SISTEMA
}

model Agency {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  logoUrl          String?
  phone            String?
  email            String?
  address          String?
  location         String?
  foundedYear      String?
  website          String?
  subscriptionPlan SubscriptionPlan @default(FREE)
  users            User[]
  deceaseds        Deceased[]
  funerals         Funeral[]
  documents        Document[]
  subscriptions    Subscription[]
  notifications    Notification[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  agencyId           String
  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(OPERATOR)
  refreshTokens      RefreshToken[]
  passwordResetToken PasswordResetToken?
  notifications      Notification[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Deceased {
  id           String    @id @default(cuid())
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  fullName     String
  age          Int?
  dateOfBirth  DateTime?
  dateOfDeath  DateTime?
  placeOfDeath String?
  photoUrl     String?
  funerals     Funeral[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Funeral {
  id                  String        @id @default(cuid())
  agencyId            String
  agency              Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  deceasedId          String
  deceased            Deceased      @relation(fields: [deceasedId], references: [id], onDelete: Cascade)
  serviceType         ServiceType   @default(CERIMONIA)
  funeralDate         DateTime
  funeralTime         String?
  locationParish      String?
  cemeteryLocation    String?
  wakeLocation        String?
  wakeDate            DateTime?
  wakeTime            String?
  notes               String?
  status              FuneralStatus @default(SCHEDULED)
  publicNoticeEnabled Boolean       @default(true)
  documents           Document[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Document {
  id              String     @id @default(cuid())
  agencyId        String
  agency          Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  funeralId       String?
  funeral         Funeral?   @relation(fields: [funeralId], references: [id], onDelete: SetNull)
  title           String
  type            DocumentType
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  uploadedById    String?
  createdAt       DateTime   @default(now())
}

model FlyerTemplate {
  id             String   @id
  name           String
  plan           FlyerPlan
  category       String   @default("PARTICIPACAO")
  description    String?
  primaryColor   String
  secondaryColor String
  accentColor    String
  fontFamily     String
  layoutStyle    String
  thumbnailUrl   String?
  editableFields Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id         String             @id @default(cuid())
  agencyId   String
  agency     Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  priceCents Int?
  validUntil DateTime?
  startedAt  DateTime           @default(now())
  createdAt  DateTime           @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  agencyId  String
  agency    Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      NotificationType @default(SISTEMA)
  title     String
  message   String
  readAt    DateTime?
  sentAt    DateTime         @default(now())
}
