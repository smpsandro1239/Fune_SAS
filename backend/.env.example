# ============================================================
# Fune_SAS — Backend (NestJS)
# Copia este ficheiro para `.env` e preenche os teus valores.
#   cp .env.example .env
# ============================================================

# ---------- Obrigatórias (o arranque FALHA se faltarem) ----------

# Base de dados PostgreSQL (Neon / Supabase / local).
# Local (Docker): docker run -d --name fune-postgres \
#   -e POSTGRES_USER=fune -e POSTGRES_PASSWORD=fune -e POSTGRES_DB=fune_sas \
#   -p 5432:5432 postgres:16-alpine
# Cloud (Neon): cola a connection string do teu projeto Neon.
DATABASE_URL="postgresql://fune:fune@localhost:5432/fune_sas?schema=public"

# Segredos JWT (gera com: openssl rand -hex 32)
JWT_ACCESS_SECRET="substituir-por-segredo-access"
JWT_REFRESH_SECRET="substituir-por-segredo-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------- Servidor ----------
PORT=4000
# URL pública do frontend (usada em links de email/checkout)
APP_URL="https://fune-sas.vercel.app"
# Origens CORS adicionais separadas por vírgula (além do APP_URL)
CORS_ORIGINS=""

# ---------- Emails (Resend) — opcional, sem isto não envia emails ----------
# https://resend.com  → API Keys
RESEND_API_KEY=""
# Remetente (domínio verificado no Resend)
EMAIL_FROM="Fune_SAS <onboarding@resend.dev>"

# ---------- Pagamentos (Stripe) — opcional, sem isto fica em modo demo ----------
# https://dashboard.stripe.com/test/apikeys  (sk_test_... em dev, sk_live_... em prod)
STRIPE_SECRET_KEY=""
# Endpoint secret do webhook (Stripe CLI: stripe listen --forward-to ...)
STRIPE_WEBHOOK_SECRET=""

# ---------- Storage S3 (uploads persistentes) — opcional ----------
# Sem isto, os uploads ficam em disco local (EFÉMERO em produção — apagam-se no redeploy).
# Compatível com AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze B2, etc.
# Bucket (cria no painel do teu provider S3-compatível)
S3_BUCKET=""
# Região, ex: "us-east-1" (AWS) / "auto" (Cloudflare R2)
S3_REGION=""
# Chaves de acesso do API token
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Endpoint customizado (OBRIGATÓRIO para R2/Spaces/MinIO/B2, vazio para AWS S3)
# Ex R2: https://<account_id>.r2.cloudflarestorage.com
# Ex SPACES: https://fra1.digitaloceanspaces.com
S3_ENDPOINT=""

# ---------- Monitorização (Sentry) — opcional, captura erros 5xx ----------
# https://sentry.io → projeto → DSN (formato: https://<key>@o<org>.ingest.sentry.io/<proj>)
# Sem DSN, o Sentry não é inicializado e não há captura de erros.
SENTRY_DSN=""

# ---------- Ambiente ----------
NODE_ENV="development"
