# Base de dados PostgreSQL (Docker: docker run -d --name fune-postgres -e POSTGRES_USER=fune -e POSTGRES_PASSWORD=fune -e POSTGRES_DB=fune_sas -p 5432:5432 postgres:16-alpine)
DATABASE_URL="postgresql://fune:fune@localhost:5432/fune_sas?schema=public"

# JWT
JWT_ACCESS_SECRET="substituir-por-segredo-access"
JWT_REFRESH_SECRET="substituir-por-segredo-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=4000
